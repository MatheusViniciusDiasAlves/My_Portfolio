# Copie este arquivo para ".env" e preencha com os seus dados.
# O arquivo .env NÃO vai para o Git (está no .gitignore).

# Porta da API (o frontend espera 3333 por padrão)
PORT=3333

# Banco de dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio

# Segredo usado para assinar o token de login.
# Gere um valor aleatório (ex.: no terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=troque-por-um-valor-aleatorio-grande
