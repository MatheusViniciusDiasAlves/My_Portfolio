# Cloudflare Pages — cabeçalhos por rota.

# Os arquivos em /assets têm hash no nome, então podem ser cacheados para sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Imagens: 30 dias.
/perfil/*
  Cache-Control: public, max-age=2592000
/projetos/*
  Cache-Control: public, max-age=2592000
/demonstrativos/*
  Cache-Control: public, max-age=2592000

# O HTML nunca fica em cache, senão um deploy novo demora a aparecer.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
